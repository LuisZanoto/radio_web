{
  "manifest_version": 3,
  "name": "Radio Web - Player e osciloscópio",
  "version": "1.1.0",
  "description": "Toca e monitora rádios online e busca estações rock/pop.",
  "permissions": ["storage", "tabs", "tabCapture"],
  "host_permissions": ["https://de1.api.radio-browser.info/*"],
  "action": {
    "default_title": "Abrir Radio Web"
  },
  "background": {
    "service_worker": "background.js"
  }
}
